# Copy to .env (docker compose reads it automatically) — never commit the real key.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b
# low = faster assistant answers, high = more careful
GROQ_REASONING_EFFORT=medium
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# vision calls per minute: 3 fits Groq's free tier (7k input tokens/min, ~2.1k per image)
GROQ_VISION_RPM=3
# GROQ_BASE_URL=https://api.groq.com/openai/v1   # or a self-hosted vLLM endpoint later
